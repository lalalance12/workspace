# ---------------------------------------------------------------------------
# Workspace environment
#
# Copy to .env.local and fill in. .env.local is gitignored; never commit it.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# Supabase project URL.
#   Dashboard -> Project Settings -> Data API -> Project URL
# Looks like: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (the new name for the anon key). Safe in the browser: it is
# scoped by Row Level Security and carries no privileges of its own.
#   Dashboard -> Project Settings -> API Keys -> Publishable key
# Looks like: sb_publishable_...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# ---------------------------------------------------------------------------
# Deliberately absent: the secret / service_role key.
#
# Non-negotiable #4 says never bypass RLS, and this app has nothing that needs
# to. Every write goes through a security-definer RPC executed AS the signed-in
# user, and the scheduler runs inside Postgres via pg_cron. There is no code
# path that wants elevated credentials, so the key is not read anywhere and is
# not listed here. If a future feature seems to need it, that is a signal the
# fix belongs in a policy or an RPC instead.
# ---------------------------------------------------------------------------
